---
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCreatedDate } from '../utils/gitDates';

const posts = (await getCollection('blog')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

function postFilePath(id: string): string {
  const md = `src/content/blog/posts/${id}.md`;
  const mdx = `src/content/blog/posts/${id}.mdx`;
  return existsSync(md) ? md : mdx;
}

function formatDate(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return iso;
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Blog">
  <main>
    <header>
      
      <h1>Blog</h1>
      <p class="intro">Writing about the things I am building and learning.</p>
    </header>

    <section aria-labelledby="latest-posts">
      <h2 id="latest-posts">Posts</h2>
      <ul class="post-list">
        {posts.map((post) => {
          const created = getCreatedDate(postFilePath(post.id));
          return (
            <li>
              <a href={`/${post.id}/`}>
                <span class="post-title">{post.data.title}</span>
                {created && (
                  <time class="post-date" datetime={created}>
                    {formatDate(created)}
                  </time>
                )}
                {post.data.description && (
                  <span class="post-excerpt">{post.data.description}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-list li {
    border-top: 1px solid #ddd8d0;
    padding: 22px 0;
  }
  .post-list a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .post-list a:hover {
    color: #8b3a2f;
    text-decoration: underline;
  }
  .post-title {
    display: block;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .post-date {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: #7a7a7a;
  }
  .post-excerpt {
    display: block;
    margin-top: 0.375rem;
    color: #646464;
  }
</style>
